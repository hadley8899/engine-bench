{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "layout": {
      "type": "string",
      "const": "inline-4"
    },
    "cylinders": {
      "type": "number",
      "const": 4
    },
    "bore": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.3
    },
    "stroke": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.3
    },
    "rodLength": {
      "type": "number",
      "minimum": 0.03,
      "maximum": 0.6
    },
    "compression": {
      "type": "number",
      "minimum": 5,
      "maximum": 20
    },
    "intakeArea": {
      "type": "number",
      "minimum": 0.00001,
      "maximum": 0.02
    },
    "exhaustArea": {
      "type": "number",
      "minimum": 0.00001,
      "maximum": 0.025
    },
    "intakeClose": {
      "type": "number",
      "minimum": 550,
      "maximum": 610
    },
    "intakeRunnerLength": {
      "default": 0.3,
      "type": "number",
      "minimum": 0.05,
      "maximum": 1.5
    },
    "ignitionAdvance": {
      "type": "number",
      "minimum": 5,
      "maximum": 38
    },
    "burnDuration": {
      "type": "number",
      "minimum": 35,
      "maximum": 75
    },
    "lambda": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.15
    },
    "inertia": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 20
    },
    "revLimit": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 20000
    },
    "mechanicalLimit": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 25000
    },
    "starterTorque": {
      "default": 70,
      "type": "number",
      "minimum": 1,
      "maximum": 20000
    },
    "induction": {
      "default": {
        "kind": "none"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "turbo"
            },
            "compressorDiameter": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 0.2
            },
            "compressorEfficiency": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 0.85
            },
            "turbineArea": {
              "type": "number",
              "minimum": 0.00002,
              "maximum": 0.01
            },
            "turbineEfficiency": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 0.85
            },
            "shaftInertia": {
              "type": "number",
              "minimum": 0.000001,
              "maximum": 0.01
            },
            "boostTarget": {
              "type": "number",
              "minimum": 0,
              "maximum": 400000
            },
            "maxShaftRpm": {
              "type": "integer",
              "minimum": 20000,
              "maximum": 400000
            },
            "blowOff": {
              "type": "boolean"
            },
            "intercooler": {
              "type": "object",
              "properties": {
                "effectiveness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.95
                },
                "pressureDrop": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "effectiveness",
                "pressureDrop"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "compressorDiameter",
            "compressorEfficiency",
            "turbineArea",
            "turbineEfficiency",
            "shaftInertia",
            "boostTarget",
            "maxShaftRpm",
            "blowOff",
            "intercooler"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "centrifugal"
            },
            "compressorDiameter": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 0.2
            },
            "compressorEfficiency": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 0.85
            },
            "driveRatio": {
              "type": "number",
              "minimum": 1,
              "maximum": 30
            },
            "maxShaftRpm": {
              "type": "integer",
              "minimum": 20000,
              "maximum": 400000
            },
            "blowOff": {
              "type": "boolean"
            },
            "intercooler": {
              "type": "object",
              "properties": {
                "effectiveness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.95
                },
                "pressureDrop": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "effectiveness",
                "pressureDrop"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "compressorDiameter",
            "compressorEfficiency",
            "driveRatio",
            "maxShaftRpm",
            "blowOff",
            "intercooler"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "roots"
            },
            "rotorDisplacement": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 0.02
            },
            "driveRatio": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 6
            },
            "efficiency": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 0.85
            },
            "bypass": {
              "type": "boolean"
            },
            "intercooler": {
              "type": "object",
              "properties": {
                "effectiveness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.95
                },
                "pressureDrop": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "effectiveness",
                "pressureDrop"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "rotorDisplacement",
            "driveRatio",
            "efficiency",
            "bypass",
            "intercooler"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fuelSystem": {
      "default": {
        "kind": "port",
        "transientCorrection": true,
        "overrunCut": true
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "carburettor"
            },
            "chokeDiameter": {
              "type": "number",
              "minimum": 0.012,
              "maximum": 0.07
            },
            "chokes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "acceleratorPump": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "chokeDiameter",
            "chokes",
            "acceleratorPump"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "throttleBody"
            },
            "transientCorrection": {
              "type": "boolean"
            },
            "overrunCut": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "transientCorrection",
            "overrunCut"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "port"
            },
            "transientCorrection": {
              "type": "boolean"
            },
            "overrunCut": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "transientCorrection",
            "overrunCut"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "direct"
            },
            "transientCorrection": {
              "type": "boolean"
            },
            "overrunCut": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "transientCorrection",
            "overrunCut"
          ],
          "additionalProperties": false
        }
      ]
    },
    "firingOrder": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "number",
          "const": 2
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "layout",
    "cylinders",
    "bore",
    "stroke",
    "rodLength",
    "compression",
    "intakeArea",
    "exhaustArea",
    "intakeClose",
    "ignitionAdvance",
    "burnDuration",
    "lambda",
    "inertia",
    "revLimit",
    "mechanicalLimit",
    "firingOrder"
  ],
  "additionalProperties": false
}
