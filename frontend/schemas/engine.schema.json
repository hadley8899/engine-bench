{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "layout": {
      "type": "string",
      "const": "inline-4"
    },
    "cylinders": {
      "type": "number",
      "const": 4
    },
    "bore": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.3
    },
    "stroke": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.3
    },
    "rodLength": {
      "type": "number",
      "minimum": 0.03,
      "maximum": 0.6
    },
    "compression": {
      "type": "number",
      "minimum": 5,
      "maximum": 20
    },
    "intakeArea": {
      "type": "number",
      "minimum": 0.00001,
      "maximum": 0.02
    },
    "exhaustArea": {
      "type": "number",
      "minimum": 0.00001,
      "maximum": 0.025
    },
    "intakeClose": {
      "type": "number",
      "minimum": 550,
      "maximum": 610
    },
    "ignitionAdvance": {
      "type": "number",
      "minimum": 5,
      "maximum": 38
    },
    "burnDuration": {
      "type": "number",
      "minimum": 35,
      "maximum": 75
    },
    "lambda": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.15
    },
    "inertia": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 20
    },
    "revLimit": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 20000
    },
    "mechanicalLimit": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 25000
    },
    "starterTorque": {
      "default": 70,
      "type": "number",
      "minimum": 1,
      "maximum": 20000
    },
    "firingOrder": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "number",
          "const": 2
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "layout",
    "cylinders",
    "bore",
    "stroke",
    "rodLength",
    "compression",
    "intakeArea",
    "exhaustArea",
    "intakeClose",
    "ignitionAdvance",
    "burnDuration",
    "lambda",
    "inertia",
    "revLimit",
    "mechanicalLimit",
    "firingOrder"
  ],
  "additionalProperties": false
}
